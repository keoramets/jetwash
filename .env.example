# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jetwash?schema=public"

# Authentication (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Public URLs and SEO
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# SMTP. Leave blank in development to log emails to the terminal.
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="JetWash <no-reply@jetwash.co.zw>"

# Uploads: local for development; cloudinary is recommended online.
UPLOAD_PROVIDER="local"
UPLOAD_DIR="public/uploads"
MAX_FILE_SIZE_MB="10"
DATABASE_POOL_SIZE="10"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="jetwash"

# Company details (JetWash's real details).
COMPANY_NAME="JetWash (Pvt) Ltd"
COMPANY_EMAIL="info@jetwash.co.zw"
COMPANY_PHONE="+263 772 327 148"
COMPANY_ADDRESS="Harare, Zimbabwe"
# Map pin for the contact page (decimal degrees; south is negative).
COMPANY_LATITUDE="-17.876306"
COMPANY_LONGITUDE="31.049917"
# WhatsApp number for the support button, digits only (e.g. 2637XXXXXXXX). Leave empty to hide the button.
NEXT_PUBLIC_COMPANY_WHATSAPP="263772906967"

# Optional bootstrap admin overrides used by npm run create-admin
ADMIN_NAME="JetWash Administrator"
ADMIN_EMAIL="admin@jetwash.co.zw"
ADMIN_PASSWORD=""
