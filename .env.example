# The JetWash website is a static site: these are read when it's built (npm run build), locally or on Netlify
# (Site configuration → Environment variables). None of them is a secret. Leave a line out to use the default
# shown in lib/seo.js.

# The site's address for canonical links, the sitemap and share images. On Netlify, URL is set automatically,
# so this is only needed to override it (for example before the jetwash.co.zw domain is connected).
NEXT_PUBLIC_SITE_URL="https://jetwash.co.zw"
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Company details (JetWash's real details; lib/seo.js has the same as defaults).
COMPANY_NAME="JetWash (Pvt) Ltd"
COMPANY_EMAIL="info@jetwash.co.zw"
COMPANY_PHONE="+263 772 327 148"
COMPANY_ADDRESS="Harare, Zimbabwe"
# WhatsApp number for the support button, digits only (e.g. 2637XXXXXXXX).
NEXT_PUBLIC_COMPANY_WHATSAPP="263772906967"
