# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jetwash?schema=public"

# Authentication (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Public URLs and SEO
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# SMTP. Leave blank in development to log emails to the terminal.
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="JetWash <no-reply@jetwash.co.zw>"

# Uploads: local for development; cloudinary is recommended online.
UPLOAD_PROVIDER="local"
UPLOAD_DIR="public/uploads"
MAX_FILE_SIZE_MB="10"
DATABASE_POOL_SIZE="10"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="jetwash"

# Company details
COMPANY_NAME="JetWash [PVT] LTD"
COMPANY_EMAIL="info@jetwash.co.zw"
COMPANY_PHONE="+263 77 123 4567"
COMPANY_ADDRESS="Industrial Park South, Harare, Zimbabwe"

# Optional bootstrap admin overrides used by npm run create-admin
ADMIN_NAME="JetWash Administrator"
ADMIN_EMAIL="admin@jetwash.co.zw"
ADMIN_PASSWORD=""
