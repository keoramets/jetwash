generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  engineType          = "client"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}
datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
  CLIENT
}
enum UserStatus {
  ACTIVE
  PENDING_APPROVAL
  SUSPENDED
  REJECTED
}
enum CompanyStatus {
  ACTIVE
  PENDING
  SUSPENDED
}
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  MORE_INFO_REQUIRED
}
enum QuoteSource {
  PUBLIC
  CLIENT_PORTAL
  ADMIN
}
enum QuoteRequestStatus {
  NEW
  REVIEWING
  QUOTED
  ACCEPTED
  REJECTED
  CONVERTED_TO_JOB
  CLOSED
}
enum QuotationStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}
enum JobStatus {
  QUOTED
  APPROVED
  SCHEDULED
  DEPLOYED
  IN_PROGRESS
  QA_REVIEW
  COMPLETED
  CANCELLED
}
enum JobPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}
enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}
enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}
enum DocumentVisibility {
  ADMIN_ONLY
  CLIENT_VISIBLE
}
enum ChatContextType {
  GENERAL
  QUOTE
  JOB
  INVOICE
}
enum ChatStatus {
  OPEN
  CLOSED
}

model User {
  id                    String          @id @default(cuid())
  name                  String
  email                 String          @unique
  passwordHash          String
  phone                 String?
  role                   UserRole        @default(CLIENT)
  status                 UserStatus      @default(PENDING_APPROVAL)
  companyId              String?
  emailVerified          DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  company                Company?        @relation(fields: [companyId], references: [id])
  clientProfile          ClientProfile?  @relation("ProfileUser")
  approvedProfiles       ClientProfile[] @relation("ApprovedBy")
  assignedQuoteRequests  QuoteRequest[]  @relation("AssignedQuoteRequests")
  quoteRequests          QuoteRequest[]  @relation("QuoteRequestUser")
  createdQuotations      Quotation[]     @relation("CreatedQuotations")
  quotationClient        Quotation[]     @relation("QuotationClient")
  createdJobs            Job[]           @relation("CreatedJobs")
  jobClient              Job[]           @relation("JobClient")
  jobAssignments         JobStaff[]
  jobStatusChanges       JobStatusHistory[] @relation("JobStatusChangedBy")
  invoiceClient          Invoice[]       @relation("InvoiceClient")
  recordedPayments       Payment[]       @relation("RecordedPayments")
  uploadedDocuments      Document[]
  sentMessages           ChatMessage[]
  notifications          Notification[]
  clientChats            Chat[]           @relation("ChatClient")
  activityLogs           ActivityLog[]
  adminNotes             AdminNote[]     @relation("AdminNoteAuthor")
  notesAboutClient       AdminNote[]     @relation("AdminNoteClient")
}

model Company {
  id            String        @id @default(cuid())
  name          String
  email         String?
  phone         String?
  address       String?
  city          String?
  country       String        @default("Zimbabwe")
  industry      String?
  status        CompanyStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  users         User[]
  clientProfiles ClientProfile[]
  quoteRequests QuoteRequest[]
  quotations    Quotation[]
  jobs          Job[]
  invoices      Invoice[]
  documents     Document[]
  chats         Chat[]
  adminNotes    AdminNote[]
}

model ClientProfile {
  id              String         @id @default(cuid())
  userId          String         @unique
  companyId       String
  position        String?
  approvalStatus  ApprovalStatus @default(PENDING)
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation("ProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  approvedBy      User?          @relation("ApprovedBy", fields: [approvedById], references: [id])
}

model Service {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  category         String
  shortDescription String
  fullDescription  String
  basePrice        Decimal?       @db.Decimal(12, 2)
  imageUrl         String?
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  quoteRequests    QuoteRequest[]
}

model Project {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  category       String
  clientName     String?
  location       String?
  summary        String
  description    String
  imageUrl       String?
  completionDate DateTime?
  metricsJson    Json?
  isFeatured     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model QuoteRequest {
  id              String             @id @default(cuid())
  requestNumber   String             @unique
  source          QuoteSource        @default(PUBLIC)
  userId          String?
  companyId       String?
  fullName        String
  email           String
  phone           String?
  companyName     String?
  serviceId       String?
  serviceRequired String
  location        String
  urgency         String             @default("Standard")
  preferredDate   DateTime?
  projectDetails  String
  status          QuoteRequestStatus @default(NEW)
  assignedToId    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User?              @relation("QuoteRequestUser", fields: [userId], references: [id])
  company         Company?           @relation(fields: [companyId], references: [id])
  service         Service?           @relation(fields: [serviceId], references: [id])
  assignedTo      User?              @relation("AssignedQuoteRequests", fields: [assignedToId], references: [id])
  quotation       Quotation?
  job             Job?
  documents       Document[]
  chats           Chat[]
}

model Quotation {
  id             String          @id @default(cuid())
  quoteNumber    String          @unique
  quoteRequestId String?         @unique
  companyId      String
  clientId       String?
  createdById    String
  issueDate      DateTime
  expiryDate     DateTime
  status         QuotationStatus @default(DRAFT)
  subtotal       Decimal         @db.Decimal(12, 2)
  discount       Decimal         @default(0) @db.Decimal(12, 2)
  taxRate        Decimal         @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal         @default(0) @db.Decimal(12, 2)
  total          Decimal         @db.Decimal(12, 2)
  notes          String?
  terms          String?
  pdfUrl         String?
  acceptedAt     DateTime?
  rejectedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  quoteRequest   QuoteRequest?   @relation(fields: [quoteRequestId], references: [id])
  company        Company         @relation(fields: [companyId], references: [id])
  client         User?           @relation("QuotationClient", fields: [clientId], references: [id])
  createdBy      User            @relation("CreatedQuotations", fields: [createdById], references: [id])
  items          QuotationItem[]
  job            Job?
  invoices       Invoice[]
  documents      Document[]
  chats          Chat[]
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  description String
  quantity    Decimal   @db.Decimal(12, 2)
  unit        String    @default("unit")
  rate        Decimal   @db.Decimal(12, 2)
  amount      Decimal   @db.Decimal(12, 2)
  sortOrder   Int       @default(0)
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model Job {
  id              String       @id @default(cuid())
  jobNumber       String       @unique
  quotationId     String?      @unique
  quoteRequestId  String?      @unique
  companyId       String
  clientId        String?
  title           String
  serviceType     String
  location        String
  description     String
  scheduledStart  DateTime?
  scheduledEnd    DateTime?
  status          JobStatus    @default(SCHEDULED)
  priority        JobPriority  @default(NORMAL)
  assignedTeam    String?
  progress        Int          @default(0)
  createdById     String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  quotation       Quotation?   @relation(fields: [quotationId], references: [id])
  quoteRequest    QuoteRequest? @relation(fields: [quoteRequestId], references: [id])
  company         Company      @relation(fields: [companyId], references: [id])
  client          User?        @relation("JobClient", fields: [clientId], references: [id])
  createdBy       User         @relation("CreatedJobs", fields: [createdById], references: [id])
  staff           JobStaff[]
  statusHistory   JobStatusHistory[]
  invoices        Invoice[]
  documents       Document[]
  chats           Chat[]
}

model JobStaff {
  jobId      String
  userId     String
  assignedAt DateTime @default(now())
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([jobId, userId])
}

model JobStatusHistory {
  id          String    @id @default(cuid())
  jobId       String
  status      JobStatus
  note        String?
  changedById String
  createdAt   DateTime  @default(now())
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  changedBy   User      @relation("JobStatusChangedBy", fields: [changedById], references: [id])
}

model Invoice {
  id           String        @id @default(cuid())
  invoiceNumber String       @unique
  jobId        String?
  quotationId  String?
  companyId    String
  clientId     String?
  issueDate    DateTime
  dueDate      DateTime
  status       InvoiceStatus @default(DRAFT)
  subtotal     Decimal       @db.Decimal(12, 2)
  taxRate      Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount    Decimal       @default(0) @db.Decimal(12, 2)
  total        Decimal       @db.Decimal(12, 2)
  amountPaid   Decimal       @default(0) @db.Decimal(12, 2)
  balanceDue   Decimal       @db.Decimal(12, 2)
  pdfUrl       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  job          Job?          @relation(fields: [jobId], references: [id])
  quotation    Quotation?    @relation(fields: [quotationId], references: [id])
  company      Company       @relation(fields: [companyId], references: [id])
  client       User?         @relation("InvoiceClient", fields: [clientId], references: [id])
  items        InvoiceItem[]
  payments     Payment[]
  documents    Document[]
  chats        Chat[]
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(12, 2)
  rate        Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id           String        @id @default(cuid())
  invoiceId    String
  amount       Decimal       @db.Decimal(12, 2)
  method       String
  reference    String?
  proofUrl     String?
  status       PaymentStatus @default(PENDING)
  recordedById String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy   User?         @relation("RecordedPayments", fields: [recordedById], references: [id])
}

model Document {
  id             String             @id @default(cuid())
  uploadedById   String
  companyId      String?
  quoteRequestId String?
  quotationId    String?
  jobId          String?
  invoiceId      String?
  chatId         String?
  fileName       String
  originalName   String
  mimeType       String
  size           Int
  url            String
  visibility     DocumentVisibility @default(CLIENT_VISIBLE)
  createdAt      DateTime           @default(now())
  uploadedBy     User               @relation(fields: [uploadedById], references: [id])
  company        Company?           @relation(fields: [companyId], references: [id])
  quoteRequest   QuoteRequest?      @relation(fields: [quoteRequestId], references: [id])
  quotation      Quotation?         @relation(fields: [quotationId], references: [id])
  job            Job?               @relation(fields: [jobId], references: [id])
  invoice        Invoice?           @relation(fields: [invoiceId], references: [id])
  chat           Chat?              @relation(fields: [chatId], references: [id])
}

model Chat {
  id             String          @id @default(cuid())
  companyId      String?
  clientId       String?
  quoteRequestId String?
  quotationId    String?
  jobId          String?
  invoiceId      String?
  contextType    ChatContextType @default(GENERAL)
  subject        String
  status         ChatStatus      @default(OPEN)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  company        Company?       @relation(fields: [companyId], references: [id])
  client         User?          @relation("ChatClient", fields: [clientId], references: [id])
  quoteRequest   QuoteRequest?  @relation(fields: [quoteRequestId], references: [id])
  quotation      Quotation?     @relation(fields: [quotationId], references: [id])
  job            Job?           @relation(fields: [jobId], references: [id])
  invoice        Invoice?       @relation(fields: [invoiceId], references: [id])
  messages       ChatMessage[]
  documents      Document[]
}

model ChatMessage {
  id         String   @id @default(cuid())
  chatId     String
  senderId   String
  message    String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender     User     @relation(fields: [senderId], references: [id])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  readAt    DateTime?
  linkUrl   String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id           String   @id @default(cuid())
  actorId      String?
  action       String
  entityType   String
  entityId     String
  metadataJson Json?
  createdAt    DateTime @default(now())
  actor        User?    @relation(fields: [actorId], references: [id])
}

model AdminNote {
  id        String   @id @default(cuid())
  authorId  String
  clientId  String?
  companyId String?
  content   String
  createdAt DateTime @default(now())
  author    User     @relation("AdminNoteAuthor", fields: [authorId], references: [id])
  client    User?    @relation("AdminNoteClient", fields: [clientId], references: [id])
  company   Company? @relation(fields: [companyId], references: [id])
}

model ContactSubmission {
  id              String   @id @default(cuid())
  fullName        String
  email           String
  phone           String?
  serviceRequired String?
  projectDetails  String?
  message         String
  status          String   @default("NEW")
  createdAt       DateTime @default(now())
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String   @default("general")
  updatedAt DateTime @updatedAt
}
